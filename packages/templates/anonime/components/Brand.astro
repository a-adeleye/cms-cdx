---
const { site, class: className = '' } = Astro.props;
---

<a class={`anonime-brand ${className}`} href="https://anonime.io/#top" aria-label={`${site.name} home`}>
  <span class="anonime-brand-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3.5 5.6 6.4v4.8c0 4.5 2.5 7.7 6.4 9.3 3.9-1.6 6.4-4.8 6.4-9.3V6.4L12 3.5Z" fill="currentColor" />
      <path d="M10.7 6.5h2.6v10.2L12 18l-1.3-1.3V6.5Z" fill="#43c89a" />
      <path d="M7.8 8.1c.8 1.2 1.4 2.7 1.7 4.5l.4 2.5-1.2-1.3A6.6 6.6 0 0 1 7 9.4v-.9l.8-.4Zm8.4 0-.8.4v.9c0 1.7-.6 3.2-1.7 4.4l-1.2 1.3.4-2.5c.3-1.8.9-3.3 1.7-4.5h1.6Z" fill="#43c89a" />
    </svg>
  </span>
  <span>{site.name}</span>
