---
const { size = 34, name = 'Rene Carter' } = Astro.props;
---

<span class="anonime-avatar" style={`--avatar-size:${size}px`} role="img" aria-label={name}>
  <svg viewBox="0 0 40 40" aria-hidden="true">
    <defs>
      <linearGradient id="anonime-avatar-bg" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#d9f4ec" />
        <stop offset="1" stop-color="#b9ddd2" />
      </linearGradient>
    </defs>
    <circle cx="20" cy="20" r="20" fill="url(#anonime-avatar-bg)" />
    <path d="M9 40c1.7-9 5.5-13.2 11.2-13.2S29 31.2 31 40" fill="#13332d" />
    <path d="M14.2 15.5c0-5 2.3-8 6.2-8 4 0 6 3.2 5.7 8.4-.3 5.4-2.4 9.1-6 9.1-3.5 0-5.9-4-5.9-9.5Z" fill="#bd806a" />
    <path d="M13.8 16.4c-.7-6.8 2.2-10.5 6.7-10.5 4.9 0 7.5 4.2 6.3 10.7-1-4.2-2.9-6.3-5.7-6.5-2.9 2.8-4.8 4.1-7.3 4.5v1.8Z" fill="#18211f" />
  </svg>
</span>
