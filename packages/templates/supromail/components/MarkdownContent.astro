---
import type { MarkdownBlock } from '../lib/markdown';
import InlineContent from './InlineContent.astro';

const { blocks = [] } = Astro.props as { blocks: MarkdownBlock[] };
---

<div class="prose">
  {blocks.map((block) => (
    block.kind === 'heading' ? (
      block.depth === 2
        ? <h2 id={block.id}><InlineContent nodes={block.children} /></h2>
        : <h3 id={block.id}><InlineContent nodes={block.children} /></h3>
    ) : block.kind === 'paragraph' ? (
      <p><InlineContent nodes={block.children} /></p>
    ) : block.kind === 'quote' ? (
      <blockquote><p><InlineContent nodes={block.children} /></p></blockquote>
    ) : block.kind === 'codeBlock' ? (
      <pre><code>{block.value}</code></pre>
    ) : block.ordered ? (
      <ol>{block.entries.map((entry) => <li><InlineContent nodes={entry} /></li>)}</ol>
    ) : (
      <ul>{block.entries.map((entry) => <li><InlineContent nodes={entry} /></li>)}</ul>
    )
  ))}
</div>
