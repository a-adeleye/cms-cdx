---
import Brand from './Brand.astro';
import Icon from './Icon.astro';

const { site } = Astro.props;
const footerGroups = [
  {
    label: 'Product',
    links: [
      ['Whispers', 'https://anonime.io/#security'],
      ['Private Drops', 'https://anonime.io/#private-drops'],
      ['Nyms', 'https://anonime.io/#how-it-works'],
      ['Pricing', 'https://anonime.io/pricing'],
    ],
  },
  {
    label: 'Company',
    links: [
      ['About', 'https://anonime.io/#about'],
      ['Blog', 'https://anonime.io/blog'],
      ['Contact', 'https://anonime.io/contact'],
    ],
  },
  {
    label: 'Legal',
    links: [
      ['Privacy Policy', 'https://anonime.io/privacy'],
      ['Terms of Service', 'https://anonime.io/terms'],
      ['Security', 'https://anonime.io/security'],
      ['Acceptable Use Policy', 'https://anonime.io/acceptable-usage-policy'],
      ['Data Processing', 'https://anonime.io/data-processing'],
    ],
  },
];
const privacyFeatures = [
  ['lock', 'End-to-end encrypted'],
  ['privacy', 'No personal data required'],
  ['ban', 'No logs. No tracking.'],
  ['server', 'Hosted with privacy-first infra'],
];
---

<footer class="anonime-footer">
  <div class="anonime-footer-container">
    <div class="anonime-footer-main">
      <section class="anonime-footer-statement">
        <Brand site={site} class="anonime-footer-logo" />
        <h2>Private communication<br />without <em>permanent trails.</em></h2>
      </section>
      <nav class="anonime-footer-directory" aria-label="Footer navigation">
        {footerGroups.map((group) => (
          <section class="anonime-footer-group" aria-labelledby={`anonime-footer-${group.label.toLowerCase()}`}>
            <h3 id={`anonime-footer-${group.label.toLowerCase()}`}>{group.label}</h3>
            {group.links.map(([label, href]) => <a href={href}>{label}</a>)}
          </section>
        ))}
      </nav>
    </div>

    <section class="anonime-footer-assurance" aria-label="Privacy guarantees">
      <p>Built with <strong>privacy by design.</strong></p>
      <div class="anonime-footer-features">
        {privacyFeatures.map(([icon, label]) => (
          <div class="anonime-footer-feature">
            <span><Icon name={icon} size={20} /></span>
            <p>{label}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="anonime-footer-bottom">
      <small>© 2026 Anonime, Inc. All rights reserved.</small>
      <p>Your privacy is your right. <strong>We protect it every day.</strong></p>
      <a href="https://x.com/anonimehq" aria-label="Anonime on X"><Icon name="x" size={18} /></a>
    </div>
  </div>
</footer>
