---
import CategoryChips from './components/CategoryChips.astro';
import ClosingBand from './components/ClosingBand.astro';
import PostCard from './components/PostCard.astro';
import SiteShell from './components/SiteShell.astro';
import {
  collectCategories,
  designArticles,
  normalizePositiveInteger,
  resolveArticles,
  resolveSite,
} from './lib/model';

const ARTICLES_PER_PAGE = 6;

const {
  site: siteInput,
  articles: articleInput,
  page: pageInput,
  totalPages: totalPagesInput,
} = Astro.props as {
  site?: unknown;
  articles?: unknown;
  page?: unknown;
  totalPages?: unknown;
};
const site = resolveSite(siteInput);
const hasCmsArticles = articleInput !== undefined;
const articles = hasCmsArticles ? resolveArticles(articleInput) : designArticles;
const page = normalizePositiveInteger(pageInput, 1);
const configuredTotalPages = totalPagesInput === undefined ? undefined : normalizePositiveInteger(totalPagesInput, 1);
// The builder paginates upstream, so a supplied collection is rendered as-is and
// only the page count is derived when the caller did not state one.
const visibleArticles = articles.slice(0, ARTICLES_PER_PAGE);
const totalPages = Math.max(1, configuredTotalPages ?? Math.ceil(articles.length / ARTICLES_PER_PAGE));
const paginationPages = Array.from({ length: Math.min(5, totalPages) }, (_, index) => index + 1);
// The chips filter the rendered page in the browser, so they are derived from the
// cards on it — a chip for a category held back by pagination would dead-end.
const categories = collectCategories(visibleArticles);
const pageHref = (pageNumber: number) => (pageNumber === 1 ? `${site.blogPath}/` : `${site.blogPath}/page/${pageNumber}/`);
---

<SiteShell site={site} page="articles">
  <header class="page-hero container">
    <p class="kicker">The {site.name} blog</p>
    <h1 class="page-title">All articles</h1>
    <p class="page-lede">Everything we have published, from deliverability fundamentals to the internals of our routing engine.</p>
    <CategoryChips categories={categories} />
  </header>

  <section class="section supromail-list-section" aria-label="Article list">
    {visibleArticles.length === 0 ? (
      <p class="container empty-state">No articles published yet.</p>
    ) : (
      <>
        <div class="container post-grid" id="articleGrid" data-stagger>
          {visibleArticles.map((article) => <PostCard article={article} blogPath={site.blogPath} showDate />)}
        </div>
        <p class="container empty-state" id="emptyState" hidden>No articles in this category yet.</p>
      </>
    )}

    {visibleArticles.length > 0 && totalPages > 1 && (
      <nav class="container pagination" aria-label="Pagination">
        {page > 1
          ? <a href={pageHref(page - 1)}>Previous</a>
          : <span class="disabled">Previous</span>}
        {paginationPages.map((pageNumber) => (
          <a
            class:list={{ current: pageNumber === page }}
            aria-current={pageNumber === page ? 'page' : undefined}
            href={pageHref(pageNumber)}
          >{pageNumber}</a>
        ))}
        {totalPages > 5 && <a href={pageHref(totalPages)}>{totalPages}</a>}
        {page < totalPages
          ? <a href={pageHref(page + 1)}>Next</a>
          : <span class="disabled">Next</span>}
      </nav>
    )}
  </section>

  <ClosingBand
    heading="Get the next one by email"
    body="One post a month on deliverability and messaging infrastructure. No product spam."
  />
</SiteShell>
